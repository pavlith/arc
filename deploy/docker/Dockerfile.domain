FROM golang:1.27.3-alpine3.23 AS build
ARG SERVICE=task
RUN apk add --no-cache gcc musl-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -trimpath -o /out/service ./cmd/arc-${SERVICE}
FROM alpine:3.23
ARG SERVICE=task
RUN addgroup -S arc && adduser -S -G arc arc && mkdir -p /var/lib/arc/${SERVICE} && chown arc:arc /var/lib/arc/${SERVICE}
COPY --from=build /out/service /usr/local/bin/arc-domain
USER arc
ENTRYPOINT ["/usr/local/bin/arc-domain", "-config", "/run/arc/config.json"]
