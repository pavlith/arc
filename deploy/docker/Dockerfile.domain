FROM golang:1.27.3-alpine3.23 AS build
ARG SERVICE=task
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/service ./cmd/arc-${SERVICE}
FROM alpine:3.23
RUN addgroup -S arc && adduser -S -G arc arc
COPY --from=build /out/service /usr/local/bin/arc-domain
USER arc
ENTRYPOINT ["/usr/local/bin/arc-domain", "-config", "/run/arc/config.json"]
