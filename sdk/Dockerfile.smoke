FROM golang:1.27.3-alpine3.23 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/arc-rpc-smoke ./cmd/arc-rpc-smoke

FROM alpine:3.23
RUN addgroup -S arc && adduser -S -G arc arc
COPY --from=build /out/arc-rpc-smoke /usr/local/bin/arc-rpc-smoke
USER arc
ENTRYPOINT ["/usr/local/bin/arc-rpc-smoke"]
