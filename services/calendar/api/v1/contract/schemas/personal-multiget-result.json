{
  "type": "object",
  "properties": {
    "workspace_id": {
      "const": ""
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": [
              "ok",
              "not_modified",
              "not_found",
              "unsupported"
            ]
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "etag": {
            "type": "string",
            "pattern": "^\"[0-9a-f]{64}\"$"
          },
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 98304
          }
        },
        "required": [
          "event_id",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "complete": {
      "type": "boolean"
    },
    "next_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    }
  },
  "required": [
    "acl_root_id",
    "items",
    "complete"
  ],
  "additionalProperties": false
}
