{
  "type": "object",
  "properties": {
    "workspace_id": {
      "const": ""
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "uid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "active",
              "deleted",
              "unsupported"
            ]
          },
          "etag": {
            "type": "string",
            "pattern": "^\"[0-9a-f]{64}\"$"
          }
        },
        "required": [
          "event_id",
          "uid",
          "revision",
          "state"
        ],
        "additionalProperties": false
      }
    },
    "complete": {
      "type": "boolean"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "required": [
    "acl_root_id",
    "items",
    "complete"
  ],
  "additionalProperties": false
}
