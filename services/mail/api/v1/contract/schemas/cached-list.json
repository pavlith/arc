{
  "type": "object",
  "properties": {
    "workspace_id": {
      "const": ""
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "folder": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "wire_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1366,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "uid_validity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "uid_next": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "remote_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "next_before_uid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "low_uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "high_uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "status": {
          "enum": [
            "ok",
            "uidvalidity_changed"
          ]
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "wire_name",
        "revision",
        "uid_validity",
        "uid_next",
        "remote_count",
        "low_uid",
        "high_uid",
        "status",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "messages": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 64
          },
          "internal_date": {
            "type": "string",
            "format": "date-time"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "subject": {
            "type": "string",
            "maxLength": 2048
          },
          "header_date": {
            "type": "string",
            "maxLength": 256
          },
          "from": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "mailbox": {
                  "type": "string",
                  "maxLength": 320
                },
                "host": {
                  "type": "string",
                  "maxLength": 320
                }
              },
              "required": [
                "name",
                "mailbox",
                "host"
              ],
              "additionalProperties": false
            },
            "maxItems": 32
          },
          "to": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "mailbox": {
                  "type": "string",
                  "maxLength": 320
                },
                "host": {
                  "type": "string",
                  "maxLength": 320
                }
              },
              "required": [
                "name",
                "mailbox",
                "host"
              ],
              "additionalProperties": false
            },
            "maxItems": 32
          },
          "message_id": {
            "type": "string",
            "maxLength": 1024
          },
          "in_reply_to": {
            "type": "string",
            "maxLength": 1024
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "folder_id": {
            "type": "string",
            "format": "uuid"
          },
          "uid_validity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          }
        },
        "required": [
          "uid",
          "flags",
          "internal_date",
          "size",
          "subject",
          "header_date",
          "from",
          "to",
          "message_id",
          "in_reply_to",
          "id",
          "folder_id",
          "uid_validity"
        ],
        "additionalProperties": false
      }
    },
    "next_before_uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    }
  },
  "required": [
    "workspace_id",
    "acl_root_id",
    "generation",
    "folder",
    "messages"
  ],
  "additionalProperties": false
}
