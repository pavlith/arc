{
  "type": "object",
  "properties": {
    "workspace_id": {
      "const": ""
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "wire_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1366,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "uid_validity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "section": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^$|^[1-9][0-9]*(\\.[1-9][0-9]*){0,5}$"
    }
  },
  "required": [
    "acl_root_id",
    "generation",
    "wire_name",
    "uid_validity",
    "uid",
    "section"
  ],
  "additionalProperties": false
}
