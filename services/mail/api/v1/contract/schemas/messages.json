{
  "type": "object",
  "properties": {
    "workspace_id": {
      "const": ""
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "wire_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1366,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status": {
      "enum": [
        "ok",
        "authentication_failed",
        "tls_failed",
        "destination_denied",
        "unavailable",
        "protocol_error",
        "credentials_missing",
        "paused",
        "disconnected",
        "limit_exceeded",
        "folder_unavailable",
        "uidvalidity_changed"
      ]
    },
    "uid_validity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "uid_next": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "exists": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "next_before_uid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 64
          },
          "internal_date": {
            "type": "string",
            "format": "date-time"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "subject": {
            "type": "string",
            "maxLength": 2048
          },
          "header_date": {
            "type": "string",
            "maxLength": 256
          },
          "from": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "mailbox": {
                  "type": "string",
                  "maxLength": 320
                },
                "host": {
                  "type": "string",
                  "maxLength": 320
                }
              },
              "required": [
                "name",
                "mailbox",
                "host"
              ],
              "additionalProperties": false
            },
            "maxItems": 32
          },
          "to": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 256
                },
                "mailbox": {
                  "type": "string",
                  "maxLength": 320
                },
                "host": {
                  "type": "string",
                  "maxLength": 320
                }
              },
              "required": [
                "name",
                "mailbox",
                "host"
              ],
              "additionalProperties": false
            },
            "maxItems": 32
          },
          "message_id": {
            "type": "string",
            "maxLength": 1024
          },
          "in_reply_to": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "uid",
          "flags",
          "internal_date",
          "size",
          "subject",
          "header_date",
          "from",
          "to",
          "message_id",
          "in_reply_to"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    }
  },
  "required": [
    "workspace_id",
    "acl_root_id",
    "revision",
    "generation",
    "wire_name",
    "status",
    "uid_validity",
    "uid_next",
    "exists",
    "messages"
  ],
  "additionalProperties": false
}
