{
  "manifest_version": 1,
  "service": {
    "name": "task",
    "build_version": "0.0.6",
    "api_major": 1
  },
  "resources": [
    {
      "type": "task.workspace",
      "actions": [
        "task.read",
        "task.create",
        "task.share",
        "task.delete",
        "access.grants.manage"
      ],
      "share_action": "task.share",
      "create_action": "task.create",
      "delete_action": "task.delete",
      "allow_inheritance": false
    }
  ],
  "operations": [
    {
      "id": "task.task.create",
      "subject": "rpc.task.v1.task.create",
      "kind": "command",
      "request_schema": "schemas/create.json",
      "response_schema": "schemas/task.json",
      "auth": {
        "mode": "resource",
        "resource_type": "task.workspace",
        "action": "task.create",
        "resource_from": "payload.acl_root_id",
        "workspace_from": "payload.workspace_id"
      },
      "idempotency": "required",
      "timeout_ms": 10000,
      "http": {
        "expose": true,
        "method": "POST",
        "path": "/api/v1/task/workspaces/{workspace_id}/roots/{acl_root_id}/tasks",
        "success_status": 201,
        "bindings": [
          {
            "source": "path",
            "name": "workspace_id",
            "field": "workspace_id",
            "type": "string"
          },
          {
            "source": "path",
            "name": "acl_root_id",
            "field": "acl_root_id",
            "type": "string"
          }
        ]
      }
    },
    {
      "id": "task.tasks.get",
      "subject": "rpc.task.v1.tasks.get",
      "kind": "query",
      "request_schema": "schemas/get.json",
      "response_schema": "schemas/task.json",
      "auth": {
        "mode": "resource",
        "resource_type": "task.workspace",
        "action": "task.read",
        "resource_from": "payload.acl_root_id",
        "workspace_from": "payload.workspace_id"
      },
      "idempotency": "none",
      "timeout_ms": 5000,
      "http": {
        "expose": true,
        "method": "GET",
        "path": "/api/v1/task/workspaces/{workspace_id}/roots/{acl_root_id}/tasks/{task_id}",
        "success_status": 200,
        "bindings": [
          {
            "source": "path",
            "name": "workspace_id",
            "field": "workspace_id",
            "type": "string"
          },
          {
            "source": "path",
            "name": "acl_root_id",
            "field": "acl_root_id",
            "type": "string"
          },
          {
            "source": "path",
            "name": "task_id",
            "field": "task_id",
            "type": "string"
          }
        ]
      }
    },
    {
      "id": "task.tasks.list",
      "subject": "rpc.task.v1.tasks.list",
      "kind": "query",
      "request_schema": "schemas/list.json",
      "response_schema": "schemas/tasks.json",
      "auth": {
        "mode": "resource",
        "resource_type": "task.workspace",
        "action": "task.read",
        "resource_from": "payload.acl_root_id",
        "workspace_from": "payload.workspace_id"
      },
      "idempotency": "none",
      "timeout_ms": 5000,
      "http": {
        "expose": true,
        "method": "GET",
        "path": "/api/v1/task/workspaces/{workspace_id}/roots/{acl_root_id}/tasks",
        "success_status": 200,
        "bindings": [
          {
            "source": "path",
            "name": "workspace_id",
            "field": "workspace_id",
            "type": "string"
          },
          {
            "source": "path",
            "name": "acl_root_id",
            "field": "acl_root_id",
            "type": "string"
          },
          {
            "source": "query",
            "name": "limit",
            "field": "limit",
            "type": "integer"
          }
        ]
      }
    },
    {
      "id": "task.roots.grants",
      "subject": "rpc.task.v1.roots.grants",
      "kind": "command",
      "request_schema": "schemas/grant.json",
      "response_schema": "schemas/granted.json",
      "auth": {
        "mode": "resource",
        "resource_type": "task.workspace",
        "action": "access.grants.manage",
        "resource_from": "payload.acl_root_id",
        "workspace_from": "payload.workspace_id"
      },
      "idempotency": "required",
      "timeout_ms": 10000,
      "http": {
        "expose": false
      }
    }
  ],
  "events": [
    {
      "name": "task.task.created",
      "subject": "evt.task.task.created.v1",
      "schema": "schemas/event.json"
    }
  ]
}
