{
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "enum": [
        "task.read",
        "task.create"
      ]
    },
    "principal_kind": {
      "enum": [
        "role",
        "user",
        "group"
      ]
    },
    "principal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "grant_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "required": [
    "workspace_id",
    "acl_root_id"
  ],
  "oneOf": [
    {
      "required": ["action", "principal_kind", "principal_id"],
      "not": { "required": ["grant_id"] }
    },
    { "required": ["grant_id"] }
  ],
  "additionalProperties": false
}
