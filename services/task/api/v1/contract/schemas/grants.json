{
  "type": "object",
  "properties": {
    "resource_id": { "type": "string", "format": "uuid" },
    "grants": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "principal_kind": { "enum": ["user", "role", "group", "service", "agent"] },
          "principal_id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expires_at": { "type": "string", "format": "date-time" }
        },
        "required": ["id", "principal_kind", "principal_id", "action"],
        "additionalProperties": false
      }
    },
    "next_cursor": { "type": "string", "format": "uuid" },
    "policy_revision": { "type": "integer", "minimum": 0 }
  },
  "required": ["resource_id", "grants", "policy_revision"],
  "additionalProperties": false
}
