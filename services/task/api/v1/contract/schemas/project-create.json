{
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "team_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 12000
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6})?$"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "acl_root_id",
    "name"
  ],
  "additionalProperties": false
}
