{
  "type": "object",
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "acl_root_id": {
      "type": "string",
      "format": "uuid"
    },
    "team_id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 12000
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6})?$"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "due_date": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "archived": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workspace_id",
    "acl_root_id",
    "id",
    "name",
    "description",
    "color",
    "status",
    "revision",
    "archived",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false
}
